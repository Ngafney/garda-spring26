def metadata_from_path(file_path: str, folder_path: str) -> dict:
    """Extracts metadata utilizing os.sep directory parsing."""
    relative_path = os.path.relpath(file_path, folder_path)
    path_parts = relative_path.split(os.sep)
    
    if len(path_parts) > 1:
        company_name = path_parts[0]
    else:
        company_name = os.path.basename(file_path).replace('.txt', '')

    base_name = os.path.basename(file_path)
    stem = os.path.splitext(base_name)[0]
    match = DATE_IN_STEM_RE.match(stem)
    
    ticker = match.group("ticker") if match else company_name
    call_date = match.group("call_date") if match else ""
    fiscal_period = match.group("fiscal_period") if match else (path_parts[2] if len(path_parts) > 2 else "")
    fiscal_year = path_parts[1] if len(path_parts) > 1 else ""

    return {
        "transcript_id": relative_path.replace('.txt', ''),
        "relative_path": relative_path,
        "transcript_path": file_path,
        "company_slug": company_name,
        "company_name": slug_to_name(company_name),
        "ticker": ticker,
        "company_key": ticker.upper(),
        "call_date": call_date,
        "fiscal_year": fiscal_year,
        "fiscal_period": fiscal_period,
        "file_name": base_name,
    }

def score_transcript(file_path: str, folder_dir: str) -> dict[str, object]:
    metadata = metadata_from_path(file_path, folder_dir)
    
    try:
        with open(file_path, 'r', encoding='utf-8') as file:
            raw_text = file.read()
    except UnicodeDecodeError:
        with open(file_path, 'r', encoding='latin-1') as file:
            raw_text = file.read()

    sections = section_texts(raw_text)

    overall_complexity = complexity_metrics(sections["overall"])
    overall_tone = tone_metrics(sections["overall"], "overall")
    prepared_tone = tone_metrics(sections["prepared"], "prepared")
    qa_tone = tone_metrics(sections["qa"], "qa")
    management_qa_tone = tone_metrics(sections["management_qa"], "management_qa")
    analyst_qa_tone = tone_metrics(sections["analyst_qa"], "analyst_question")
    topical = topic_metrics(sections["overall"])
    guidance = guidance_flags(raw_text)

    qna_reality_gap = management_qa_tone["management_qa_net_tone"] - prepared_tone["prepared_net_tone"]
    analyst_management_gap = management_qa_tone["management_qa_net_tone"] - analyst_qa_tone["analyst_question_net_tone"]

    growth_signal = overall_tone["overall_net_tone"] + topical["demand_net"] + topical["capex_net"] - topical["macro_risk_density"]
    margin_signal = (
        topical["pricing_power_net"]
        + topical["automation_density"]
        - topical["labor_pressure_density"]
        - topical["supply_chain_pressure_density"]
    )
    credibility_signal = analyst_management_gap + qna_reality_gap - topical["uncertainty_density"]
    composite_signal = growth_signal + margin_signal + credibility_signal

    return {
        **metadata,
        "qa_detected": int(bool(sections["qa"])),
        **overall_complexity,
        **overall_tone,
        **prepared_tone,
        **qa_tone,
        **management_qa_tone,
        **analyst_qa_tone,
        **topical,
        **guidance,
        "qna_reality_gap": qna_reality_gap,
        "analyst_management_gap": analyst_management_gap,
        "growth_signal": growth_signal,
        "margin_signal": margin_signal,
        "credibility_signal": credibility_signal,
        "composite_signal": composite_signal,
    }

def add_company_time_series_features(panel: pd.DataFrame) -> pd.DataFrame:
    # Requires datetime conversion in execution block
    panel = panel.sort_values(by=["company_key", "call_date_dt", "fiscal_year", "fiscal_period"]).copy()
    for column in ROLLING_SIGNAL_COLUMNS:
        if column in panel.columns:
